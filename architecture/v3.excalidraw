      "boundElements": [],
      "updated": 1788189815802,
      "link": null,
      "locked": false,
      "text": "Now when we use the 2 nd api to create a new \ncharacter we need to pass the name and the class\nfor now lets keep it mage and melle \nwhen we are creating new character it should use that \nmage/melle class with default values to create\ntheir name folder with the json files and default values \nand description  \n\n",
      "fontSize": 20,
