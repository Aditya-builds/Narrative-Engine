      "isDeleted": false,
      "boundElements": [],
      "updated": 1788270201023,
      "link": null,
      "locked": false,
      "text": "Now when we use the 2 nd api to create a new \ncharacter we need to pass the name and the class\nfor now lets keep it mage and melle \nwhen we are creating new character it should use that \nmage/melle class with default values to create\ntheir name folder with the json files and default values \nand description  \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now when we use the 2 nd api to create a new \ncharacter we need to pass the name and the class\nfor now lets keep it mage and melle \nwhen we are creating new character it should use that \nmage/melle class with default values to create\ntheir name folder with the json files and default values \nand description  \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
