      "boundElements": [],
      "updated": 1788270201023,
      "link": null,
      "locked": false,
      "text": "UI calls the api from home screen  \nGET\n/characters\nGET\n/characters/{name}\nGET\n/characters/{name}/portrait\nPOST\n/create_new_character/{name}/{class}\nPUT\n/update_character/{name}\nPersonas\n\nMethod        URL\nGET\n/personas\nGET\n/personas/{name}\nGET\n/personas/{name}/portrait\nPOST\n/create_new_persona/{name}/{class}\nPUT\n/update_persona/{name}\n\n ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UI calls the api from home screen  \nGET\n/characters\nGET\n/characters/{name}\nGET\n/characters/{name}/portrait\nPOST\n/create_new_character/{name}/{class}\nPUT\n/update_character/{name}\nPersonas\n\nMethod        URL\nGET\n/personas\nGET\n/personas/{name}\nGET\n/personas/{name}/portrait\nPOST\n/create_new_persona/{name}/{class}\nPUT\n/update_persona/{name}\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
