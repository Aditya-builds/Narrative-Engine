      "isDeleted": false,
      "boundElements": [],
      "updated": 1788270201023,
      "link": null,
      "locked": false,
      "text": "When we are chatting with the \ncharacter using the persona \nwe need to pass the enitre \ncharacter.json of both \nuse the api to update stats \nif situation required like fighting \nchanging clothes \n\nits the agents intellignce\nthat will update the 7  json \nfiles ",
      "fontSize": 99.52107268777637,
      "fontFamily": 5,
      "textAlign": "left",
