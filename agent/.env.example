OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4
OPENAI_REASONING_EFFORT=none
QUARKUS_BASE_URL=http://localhost:8080

# Set true to chat without calling OpenAI (local mock replies).
ENABLE_MOCK_LLM=false
# Chat POSTs allowed per client IP per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20
# JSON logs on stderr when true; otherwise text logs include requestId=.
NARRATIVE_JSON_LOGS=false

# Optional fallback when the UI chooses "use server credentials".
# The UI can also send X-OpenAI-Api-Key; replace-me is treated as missing.
# Optional USD-per-1M-token rates for local cost estimates. Usage logs work without them.
# LLM_PRICE_INPUT_PER_MILLION=
# LLM_PRICE_CACHED_INPUT_PER_MILLION=
# LLM_PRICE_OUTPUT_PER_MILLION=
# LLM_MODEL_PRICING_JSON={"model-name":{"input":0,"cached_input":0,"output":0}}
