OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4
OPENAI_REASONING_EFFORT=none
QUARKUS_BASE_URL=http://localhost:8080

# Optional fallback when the UI chooses "use server credentials".
# The UI can also send X-OpenAI-Api-Key; replace-me is treated as missing.
# Optional USD-per-1M-token rates for local cost estimates. Usage logs work without them.
