                <mxCell id="11" value="&lt;b&gt;APIs&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;GET&lt;/b&gt; /characters/{name}&lt;br&gt;Mapper combines character.json and all sub JSON files into one object.&lt;br&gt;&lt;br&gt;2. &lt;b&gt;POST&lt;/b&gt; /create_new_character/{name}&lt;br&gt;Creates the folder and JSON files. Missing data is stored empty with the same keys. (&lt;span style=&quot;background-color: initial;&quot;&gt;Now when we use the 2 nd api to create a new&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;character we need to pass the name and the class&lt;/div&gt;&lt;div&gt;for now lets keep it mage and melle&amp;nbsp;&lt;/div&gt;&lt;div&gt;when we are creating new character it should use that&amp;nbsp;&lt;/div&gt;&lt;div&gt;mage/melle class with default values to create&lt;/div&gt;&lt;div&gt;their name folder with the json files and default values&amp;nbsp;&lt;/div&gt;&lt;div&gt;and description&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;)&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;3. &lt;b&gt;PUT&lt;/b&gt; /update_character/{name}&lt;br&gt;Updates fields on an existing character (stats, relationships, and other files)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#111111;" vertex="1" parent="1">
                    <mxGeometry x="-1153" y="477" width="578" height="462" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="&lt;b&gt;character.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#111111&quot;&gt;hub / manifest&lt;/font&gt;&lt;hr&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;id&quot;: &quot;aurora&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;name&quot;: &quot;Aurora&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;rank&quot;: &quot;B&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;gender&quot;: &quot;female&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;age&quot;: &quot;20&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;files&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;stats&quot;: &quot;stats.json&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;abilities&quot;: &quot;abilities.json&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;personality&quot;: &quot;personality.json&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;relationships&quot;: &quot;relationships.json&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;appearance&quot;: &quot;appearance.json&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;equipment&quot;: &quot;equipment.json&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;visualIdentity&quot;: &quot;visual-identity.json&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontFamily=Courier New;fontSize=11;fontColor=#111111;" vertex="1" parent="1">
                    <mxGeometry x="-150" y="-14" width="340" height="340" as="geometry"/>
                </mxCell>
