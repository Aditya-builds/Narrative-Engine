                <mxCell id="18" value="&lt;b&gt;appearance.json&lt;/b&gt;&lt;hr&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;body&quot;: { heightCm, weightKg, build },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;measurements&quot;: { chestCm, waistCm, hipsCm },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;physicalFeatures&quot;: { hair, eyes, skin, face }&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;fontColor=#111111;" vertex="1" parent="1">
