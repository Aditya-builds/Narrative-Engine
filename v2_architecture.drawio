                <mxCell id="14" value="&lt;b&gt;stats.json&lt;/b&gt;&lt;hr&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;attributes&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;vigor, mind, endurance,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;strength, dexterity,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;intelligence, faith, arcane&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;strengths&quot;: [ &quot;...&quot; ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;weaknesses&quot;: [ &quot;...&quot; ]&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;fontColor=#111111;" vertex="1" parent="1">
