                <mxCell id="17" value="&lt;b&gt;relationships.json&lt;/b&gt;&lt;hr&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;relationships&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;laxus&quot;: 72,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;runa&quot;: 64,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;erza&quot;: 81,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;natsu&quot;: 55&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#111111&quot;&gt;Keys are other character ids.&lt;br&gt;New interactions are appended with the update API.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=11;fontColor=#111111;" vertex="1" parent="1">
